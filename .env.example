# Sao chép thành .env (KHÔNG commit). Sinh khóa: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=vatlieunoithat.vn,www.vatlieunoithat.vn
DJANGO_CSRF_TRUSTED_ORIGINS=https://vatlieunoithat.vn,https://www.vatlieunoithat.vn
SITE_URL=https://vatlieunoithat.vn
# Đường dẫn trang quản trị (đổi sang giá trị khó đoán ở production)
ADMIN_URL=quan-tri/
# PostgreSQL (production). Bỏ trống = SQLite cho dev.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/vlnt
# Chỉ bật khi chạy sau reverse proxy tin cậy (Nginx) để lấy đúng IP cho chống spam
TRUST_X_FORWARDED_FOR=0
FORM_THROTTLE_LIMIT=5
FORM_THROTTLE_WINDOW=600
LOG_LEVEL=INFO
# Zoho CRM: đồng bộ lead/báo giá (để trống = tắt). Tạo Self Client tại https://api-console.zoho.com
# scope: ZohoCRM.modules.leads.ALL,ZohoCRM.modules.notes.CREATE  -> đổi code lấy refresh token.
# Data center khác .com: ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu và ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
# API cho agent Zia (header X-API-Key). Để trống = tắt API.
AGENT_API_KEY=
AGENT_API_RATE_PER_MIN=60
